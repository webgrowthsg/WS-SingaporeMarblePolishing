# --- Public site configuration ---
# Canonical origin (provisional build default; ownership unverified)
PUBLIC_SITE_URL=https://singaporemarblepolishing.com

# Environment mode: development | staging | production
SITE_ENV=development

# --- Optional verified contact values ---
# Only set when verified by the operator. Leave blank to hide the channel.
WHATSAPP_NUMBER=
TELEPHONE=
EMAIL_ADDRESS=

# --- Analytics (optional; leave blank to keep analytics inert) ---
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=

# --- Lead delivery (server-only; NOT exposed to client) ---
# Authorised destination email or CRM endpoint for lead notifications
LEAD_NOTIFICATION_DESTINATION=
# Supabase credentials (auto-populated in Bolt environment)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
